#!/bin/bash
# gbmux — Gigabyte AERO X16 display-mux / dGPU-power control for Linux.
# Mirrors GiMATE's "GPU Mux Switch" + GpuPowerGear dGPU-off feature.
#
# Paths (from DSDT disassembly, AERO X16 1WH BIOS FB07):
#   get mode : \_SB.PCI0.AMW0.WMBC(0, 0xE6, buf) -> RXCM(0xD0) & 0x7F
#   set mode : \_SB.PCI0.AMW0.WMBD(0, 0xE6, {b}) -> WXCM(0xD0, b)   (EC mailbox)
#   dGPU on  : \_SB.PCI0.AMW0.WMBD(0, 0x51, {4}) -> WXCM(0xC7,0) + PEGP._ON + rescan
#   dGPU off : \_SB.PCI0.AMW0.WMBD(0, 0x51, {3}) -> WXCM(0xC7,1) + Notify(PEGP,eject)
#
# mode byte: 0=Dynamic (BIOS hybrid), 1=Discrete (dGPU only), 2=MsHybrid
# Mux mode is applied by the EC at next POST -> reboot required (same as Windows).
set -uo pipefail

CALL=/proc/acpi/call
AMW0='\_SB.PCI0.AMW0'
GUID_SET=/sys/bus/wmi/devices/ABBC0F75-8EA1-11D1-00A0-C90629100000-2
LOCK=${GBMUX_LOCK:-/run/gbmux.lock}

# Absolute helpers. A sudo that preserves PATH must not be able to substitute these.
first_exec() {
    local c
    for c in "$@"; do
        [[ -x $c ]] && { printf '%s' "$c"; return 0; }
    done
    printf '%s' "$1"
}
FLOCK=$(first_exec /usr/bin/flock /bin/flock)
TR=$(first_exec /usr/bin/tr /bin/tr)
LSPCI=$(first_exec /usr/bin/lspci /sbin/lspci)
MODPROBE=$(first_exec /usr/sbin/modprobe /sbin/modprobe)
SED=$(first_exec /usr/bin/sed /bin/sed)
SEQ=$(first_exec /usr/bin/seq /bin/seq)
SLEEP=$(first_exec /bin/sleep /usr/bin/sleep)
GREP=$(first_exec /usr/bin/grep /bin/grep)

die() { echo "gbmux: $*" >&2; exit 1; }

# Allowlisted ACPI: AMW0 WMBC/WMBD, method 0xE6 (mux) or 0x51 (dGPU power).
acpi_expr_allowed() {
    local re='^\\_SB\.PCI0\.AMW0\.WMB[CD] 0 0x([Ee]6|51) \{[ 0-9xXa-fA-F]+\}$'
    [[ "$1" =~ $re ]]
}

acall() {
    local out
    exec 9>"$LOCK" || die "cannot open ACPI lock $LOCK"
    "$FLOCK" 9 || die "cannot acquire ACPI lock $LOCK"
    # printf: echo would swallow payloads that look like flags.
    printf '%s\n' "$1" >"$CALL" 2>/dev/null || die "write failed: $1"
    out=$("$TR" -d '\0' <"$CALL")
    "$FLOCK" -u 9
    case "$out" in *Error*|*rror:*) die "ACPI call failed: $1 -> $out";; esac
    printf '%s' "$out"
}

mode_name() { case "$1" in 0) echo Dynamic;; 1) echo Discrete;; 2) echo MsHybrid;; *) echo "unknown($1)";; esac; }

get_mode() {
    local out; out=$(acall "$AMW0.WMBC 0 0xE6 {0}")
    [[ "$out" =~ ^0x([0-9a-fA-F]+)$ ]] || die "WMBC 0xE6 returned: $out"
    printf '%d' "0x${BASH_REMATCH[1]}"
}

dgpu_present() { "$LSPCI" -d 10de: 2>/dev/null | "$GREP" -q .; }
dgpu_bound()   { "$LSPCI" -d 10de: -k 2>/dev/null | "$GREP" -q 'Kernel driver in use: nvidia'; }

rescan_pci() {
    for _ in $("$SEQ" 1 40); do
        dgpu_present && return 0
        printf '%s\n' 1 > /sys/bus/pci/rescan 2>/dev/null
        "$SLEEP" 0.25
    done
    return 1
}

if [[ "${GBMUX_LIB:-}" == 1 ]]; then
    return 0 2>/dev/null || true
fi

[[ $EUID -eq 0 ]] || die "needs root — run via sudo"
[[ -d /sys/bus/wmi/devices ]] && compgen -G '/sys/bus/wmi/devices/ABBC0F75-*' >/dev/null \
    || die "Gigabyte WMI interface (ABBC0F75) not present — unsupported machine"
[[ -e $CALL ]] || "$MODPROBE" acpi_call 2>/dev/null
[[ -e $CALL ]] || die "acpi_call not available (install acpi-call-dkms)"

case "${1:-}" in
  status)
    m=$(get_mode)
    echo "mux mode   : $(mode_name "$m") (0x$(printf %x "$m"))"
    if dgpu_present; then
      echo "dGPU       : on PCI bus"; "$LSPCI" -d 10de: -nn | "$SED" 's/^/             /'
      dgpu_bound && echo "             driver: nvidia bound" || echo "             driver: not nvidia/unbound"
    else
      echo "dGPU       : powered off (D3cold)"
    fi
    ;;
  mode)
    get_mode; echo
    ;;
  dynamic|discrete|hybrid)
    case "$1" in dynamic) v=0;; discrete) v=1;; hybrid) v=2;; esac
    acall "$AMW0.WMBD 0 0xE6 { $v }" >/dev/null
    new=$(get_mode)
    echo "mux mode now: $(mode_name "$new")"
    echo "takes effect at next POST — reboot to apply"
    ;;
  gpu)
    case "${2:-}" in
      on)
        acall "$AMW0.WMBD 0 0x51 { 0x04 }" >/dev/null
        if rescan_pci; then
          echo "dGPU powered on:"; "$LSPCI" -d 10de: -nn | "$SED" 's/^/  /'
        else
          echo "no NVIDIA device after power-on — check dmesg" >&2; exit 1
        fi
        ;;
      off)
        dgpu_bound && die "nvidia driver bound — unbind/remove it first (refusing to pull power)"
        acall "$AMW0.WMBD 0 0x51 { 0x03 }" >/dev/null
        echo "dGPU power-off issued"
        ;;
      *) die "usage: gbmux gpu on|off";;
    esac
    ;;
  call)  # escape hatch: gbmux call '\_SB.PCI0.AMW0.WMBC 0 0xE6 {0}'
    [[ -n "${2:-}" ]] || die "usage: gbmux call '<acpi expression>'"
    acpi_expr_allowed "$2" || die "ACPI expression not allowed (WMBC/WMBD 0xE6|0x51 only)"
    acall "$2"; echo
    ;;
  *) cat <<'EOF'
gbmux — Gigabyte AERO X16 mux/dGPU control
  gbmux status            show mux mode + dGPU state
  gbmux mode              print raw mux mode (0=Dynamic 1=Discrete 2=MsHybrid)
  gbmux dynamic           hybrid (BIOS auto, iGPU drives panel)  [reboot]
  gbmux discrete          dGPU-only mode                          [reboot]
  gbmux hybrid            MS-hybrid mode                          [reboot]
  gbmux gpu on            power dGPU onto the PCI bus (runtime)
  gbmux gpu off           power dGPU off (runtime; refuses if nvidia bound)
  gbmux call '<expr>'     acpi_call allowlisted to AMW0 WMBC/WMBD 0xE6|0x51
EOF
    ;;
esac
