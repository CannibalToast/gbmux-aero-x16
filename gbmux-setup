#!/usr/bin/env bash
# gbmux-setup — install the pinned NVIDIA driver for GB206M (RTX 5070 mobile).
# Safe to re-run; refuses when nouveau is live (reboot with blacklist first).
set -uo pipefail

VER=615.71.09
# NVIDIA-published digest: .../615.71.09/NVIDIA-Linux-x86_64-615.71.09.run.sha256sum
SHA256=cdceed22bbeb61248d1a6deabc2596673e3a6501698ee71ac8d2fdc28f3b70fe
URL="https://us.download.nvidia.com/XFree86/Linux-x86_64/${VER}/NVIDIA-Linux-x86_64-${VER}.run"
DEST="/var/cache/gbmux/NVIDIA-Linux-x86_64-${VER}.run"

die() { echo "gbmux-setup: $*" >&2; exit 1; }

verify_installer() {
    local dest=$1 expected=$2 got
    [[ -f "$dest" && ! -L "$dest" ]] || return 1
    got=$(sha256sum "$dest" | awk '{print $1}')
    [[ "$got" == "$expected" ]]
}

# Optional args (tests only): dest, sha256, url. Production always uses the pins.
ensure_installer() {
    local dest=${1:-$DEST} expected=${2:-$SHA256} url=${3:-$URL}
    local part=${dest}.part old_umask
    mkdir -p "$(dirname "$dest")" || {
        echo "gbmux-setup: cannot create $(dirname "$dest")" >&2
        return 1
    }
    if [[ ! -f $dest ]]; then
        echo "downloading $url"
        old_umask=$(umask)
        umask 077
        rm -f "$part"
        if ! curl --fail --proto '=https' --tlsv1.2 --retry 3 -o "$part" "$url"; then
            rm -f "$part"
            umask "$old_umask"
            echo "gbmux-setup: download failed" >&2
            return 1
        fi
        if ! verify_installer "$part" "$expected"; then
            rm -f "$part"
            umask "$old_umask"
            echo "gbmux-setup: SHA256 mismatch after download — deleted $part (expected $expected)" >&2
            return 1
        fi
        mv -f "$part" "$dest"
        umask "$old_umask"
    fi
    if ! verify_installer "$dest" "$expected"; then
        rm -f "$dest"
        echo "gbmux-setup: SHA256 mismatch — deleted $dest (expected $expected)" >&2
        return 1
    fi
}

if [[ "${GBMUX_SETUP_LIB:-}" == 1 ]]; then
    return 0 2>/dev/null || true
fi

# Test-only entrypoint: hash/download without becoming root or executing the payload.
if [[ "${GBMUX_SETUP_DRY_RUN:-}" == 1 && "${GBMUX_SETUP_ALLOW_NONROOT:-}" == 1 ]]; then
    ensure_installer \
        "${GBMUX_SETUP_DEST:-$DEST}" \
        "${GBMUX_SETUP_SHA256:-$SHA256}" \
        "${GBMUX_SETUP_URL:-$URL}" || exit 1
    echo "gbmux-setup: installer hash ok"
    exit 0
fi

[[ $EUID -eq 0 ]] || die "needs root"

if [[ -f /sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c ]]; then
    sb=$(od -An -tu1 -j4 -N1 /sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c | tr -d ' ')
    [[ "$sb" == "1" ]] && die "Secure Boot is ON — unsigned nvidia modules won't load. Disable SB or enroll a MOK first."
fi

if lsmod | grep -q '^nouveau'; then
    echo "nouveau is loaded. Write /etc/modprobe.d/blacklist-nouveau.conf,"
    echo "run update-initramfs -u, reboot, then re-run this script."
    exit 1
fi

ensure_installer || exit 1

if [[ "${GBMUX_SETUP_DRY_RUN:-}" == 1 ]]; then
    echo "gbmux-setup: installer hash ok"
    exit 0
fi

# Re-hash immediately before any execution (cache hit or fresh download).
if ! verify_installer "$DEST" "$SHA256"; then
    rm -f "$DEST"
    die "SHA256 mismatch — deleted $DEST (expected $SHA256)"
fi
sh "$DEST" --check || die "archive corrupt — delete $DEST and retry"
if ! verify_installer "$DEST" "$SHA256"; then
    rm -f "$DEST"
    die "SHA256 mismatch after --check — deleted $DEST (expected $SHA256)"
fi
sh "$DEST" --silent --accept-license --dkms --no-x-check || die "installer failed — see /var/log/nvidia-installer.log"

modprobe nvidia nvidia_modeset nvidia_uvm nvidia_drm 2>/dev/null
nvidia-smi && echo && echo "done — PRIME offload: __NV_PRIME_RENDER_OFFLOAD=1 <cmd>"
